# 우리동네 유치원 - 환경 변수 템플릿
# 이 파일을 복사하여 .env.local로 저장하고 값을 입력하세요

# ===== 유치원 알리미 API =====
# https://e-childschoolinfo.moe.go.kr/ 에서 발급
KINDERGARTEN_API_KEY=

# ===== Kakao API =====
# https://developers.kakao.com/ 에서 발급
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# ===== Supabase =====
# https://supabase.com/ 에서 프로젝트 생성 후 확인
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ===== Analytics (optional) =====
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
