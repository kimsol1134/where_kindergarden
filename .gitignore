# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
ios/NativeApp/.build/
ios/WhereKindergartenNative/Config/KakaoKeys.local.xcconfig

# misc
.DS_Store
.clang-module-cache/
*.pem

# Local agent worktrees are machine-specific nested repositories.
/.claude/worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data output (large JSON files)
scripts/data-output/*
!scripts/data-output/review-verification-state.json
!scripts/data-output/review-body-cache.json

# iOS native build artifacts
ios/DerivedData/
.env*.local

# App Store 심사 연락처 — 개인 휴대폰 번호이므로 저장소에 두지 않는다.
# 실제 값은 App Store Connect에 이미 설정돼 있고, 이 파일이 없으면
# fastlane deliver가 해당 필드를 건드리지 않고 ASC 값을 그대로 유지한다.
ios/WhereKindergartenNative/fastlane/metadata/review_information/phone_number.txt

# 사업 전략 문서 — 로컬 보관만. 저장소(공개)에 올리지 않는다.
/reports/
/outputs/
!/outputs/v2.2.4-screenshots/

# scripts/data-output은 iCloud 아카이브로의 심볼릭 링크다.
# 커밋하면 로컬 경로가 노출되고 다른 환경에서 깨진다.
/scripts/data-output

# ---------------------------------------------------------------------------
# 빌드 산출물 — 커밋하면 릴리스마다 20MB 이상씩 히스토리가 불어난다.
# 모두 빌드/도구 실행으로 재생성되므로 저장소에 둘 이유가 없다.
# ---------------------------------------------------------------------------

# fastlane gym 출력 (아카이브/서명 결과)
ios/WhereKindergartenNative/*.ipa
ios/WhereKindergartenNative/*.app.dSYM.zip
ios/WhereKindergartenNative/fastlane/report.xml

# 스크린샷 파이프라인 작업 파일 (output/final의 완성본은 유지)
/output/temp/

# 도구 실행 로그 및 디버그 캡처
/.playwright-mcp/
/tmp_compare.png
/.codex-kakao-stable.png
