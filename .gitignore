# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
ios/NativeApp/.build/
ios/WhereKindergartenNative/Config/KakaoKeys.local.xcconfig

# misc
.DS_Store
.clang-module-cache/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data output (large JSON files)
scripts/data-output/*
!scripts/data-output/review-verification-state.json
!scripts/data-output/review-body-cache.json

# iOS native build artifacts
ios/DerivedData/
.env*.local

# App Store 심사 연락처 — 개인 휴대폰 번호이므로 저장소에 두지 않는다.
# 실제 값은 App Store Connect에 이미 설정돼 있고, 이 파일이 없으면
# fastlane deliver가 해당 필드를 건드리지 않고 ASC 값을 그대로 유지한다.
ios/WhereKindergartenNative/fastlane/metadata/review_information/phone_number.txt
