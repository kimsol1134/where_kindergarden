# TestFlight 배포 환경 변수 (예시)
# 이 파일을 .env.local 또는 쉘 환경에 설정하세요

# ============================================
# 방법 1: Apple ID 방식 (수동 로그인 필요)
# ============================================
APPLE_ID=your-apple-id@example.com
TEAM_ID=XXXXXXXXXX
ITC_TEAM_ID=XXXXXXXXXX

# ============================================
# 방법 2: App Store Connect API Key (권장)
# ============================================
# App Store Connect > Users and Access > Keys에서 생성
# https://appstoreconnect.apple.com/access/api

# API Key ID (예: ABC123XYZ)
APP_STORE_CONNECT_API_KEY_ID=

# Issuer ID (예: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
APP_STORE_CONNECT_API_ISSUER_ID=

# API Key 내용 (base64 인코딩)
# 다운로드한 .p8 파일을 base64로 인코딩:
#   cat AuthKey_ABC123XYZ.p8 | base64
APP_STORE_CONNECT_API_KEY_CONTENT=

# ============================================
# 앱 정보
# ============================================
APP_IDENTIFIER=com.solkim.kindergarden
