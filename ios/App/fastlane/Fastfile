# Fastfile - TestFlight 자동 배포
#
# 사용법:
#   cd ios/App && fastlane beta
#
# 필요한 환경 변수:
#   - APPLE_ID: Apple ID 이메일
#   - TEAM_ID: Apple Developer Team ID
#   - ITC_TEAM_ID: App Store Connect Team ID
#   - MATCH_PASSWORD: (match 사용 시) 인증서 암호화 비밀번호
#
# 또는 App Store Connect API Key 사용 (권장):
#   - APP_STORE_CONNECT_API_KEY_ID
#   - APP_STORE_CONNECT_API_ISSUER_ID
#   - APP_STORE_CONNECT_API_KEY_CONTENT (또는 파일 경로)

default_platform(:ios)

platform :ios do
  desc "TestFlight에 새 버전 배포"
  lane :beta do
    # 1. 빌드 번호 자동 증가
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest_testflight_build_number + 1
    )

    # 2. 앱 빌드 (Release)
    build_app(
      workspace: nil,
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "App.ipa",
      clean: true,
      silent: false,
      xcargs: "-allowProvisioningUpdates"
    )

    # 3. TestFlight 업로드
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    # 4. 완료 알림
    puts "✅ TestFlight 업로드 완료!"
    puts "📱 App Store Connect에서 빌드 처리 상태를 확인하세요."
  end

  desc "TestFlight 배포 (API Key 사용)"
  lane :beta_with_api_key do
    # App Store Connect API Key 설정
    # key_filepath 사용 (OpenSSL 3.6+ base64 호환 문제 우회)
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_FILEPATH"] || "~/.private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8"
    )

    # 빌드 번호 자동 증가
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key) + 1
    )

    # 앱 빌드
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "App.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )

    # TestFlight 업로드
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    puts "✅ TestFlight 업로드 완료!"
  end

  desc "로컬 빌드만 (업로드 없이)"
  lane :build_only do
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "App.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )
    puts "✅ 빌드 완료: ./build/App.ipa"
  end

  desc "App Store Connect 메타데이터 업로드"
  lane :upload_metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      metadata_path: "./fastlane/metadata",
      overwrite_screenshots: false,
      submit_for_review: false,
      automatic_release: false
    )
    puts "✅ 메타데이터 업로드 완료!"
  end

  desc "App Store Connect 메타데이터 업로드 (API Key 사용)"
  lane :upload_metadata_with_api_key do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_FILEPATH"] || "~/.private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8"
    )

    # package.json에서 버전 읽기
    version = JSON.parse(File.read("../../../package.json"))["version"]

    # name.txt를 임시 제외 (deliver에 포함되면 "app name already being used" 에러 발생)
    name_file = "./fastlane/metadata/ko/name.txt"
    name_backup = "./fastlane/metadata/ko/name.txt.bak"
    name_excluded = File.exist?(name_file)
    if name_excluded
      FileUtils.mv(name_file, name_backup)
      puts "📝 name.txt 임시 제외 (deliver 충돌 방지)"
    end

    begin
      deliver(
        api_key: api_key,
        app_version: version,
        skip_binary_upload: true,
        skip_screenshots: true,
        force: true,
        metadata_path: "./fastlane/metadata",
        overwrite_screenshots: false,
        submit_for_review: false,
        automatic_release: false,
        precheck_include_in_app_purchases: false
      )
      puts "✅ 메타데이터 업로드 완료! (v#{version})"
    ensure
      # name.txt 복원 (에러 발생 시에도 반드시 복원)
      if name_excluded && File.exist?(name_backup)
        FileUtils.mv(name_backup, name_file)
        puts "📝 name.txt 복원 완료"
      end
    end
  end

  desc "App Store 출시 (빌드 + 메타데이터 + 심사 제출)"
  lane :release do
    # 빌드 번호 자동 증가
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: latest_testflight_build_number + 1
    )

    # 앱 빌드
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "App.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )

    # App Store에 업로드 (메타데이터 포함)
    deliver(
      force: true,
      metadata_path: "./fastlane/metadata",
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true
    )

    puts "✅ App Store 업로드 완료!"
    puts "📱 App Store Connect에서 심사를 제출하세요."
  end

  # 에러 핸들링
  error do |lane, exception|
    puts "❌ 에러 발생: #{exception.message}"
  end
end
